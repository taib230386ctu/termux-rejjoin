local liveParsedBees = {}

local function updateTotalHiveCostDisplay(beesList)
    local bees = beesList or liveParsedBees
    if not bees or next(bees) == nil then return end

    local targetLvl = tonumber(TargetInput.Text) or 8
    local _, _, bonusPct = getParsedHoneycomb()
    local currentBuff = manualBonusPercent or bonusPct
    local bondPerTreat = 10 * (1 + (currentBuff / 100))

    local targetCumulativeBond = CumulativeBondToReachLvl[targetLvl] or 0
    local totalBondNeededForHive = 0
    local totalTreatsNeededForHive = 0

    for _, b in pairs(bees) do
        if b and b.Lvl and b.Lvl < targetLvl then
            local missingBondForThisBee = 0
            if targetCumulativeBond > 0 and b.TotalBond then
                missingBondForThisBee = math.max(0, targetCumulativeBond - b.TotalBond)
            else
                local cur = b.CurBond or 0
                local step = b.MaxBond or 15000
                missingBondForThisBee = math.max(0, step - cur)
            end

            local treatsForBee = math.ceil(missingBondForThisBee / bondPerTreat)
            totalBondNeededForHive = totalBondNeededForHive + missingBondForThisBee
            totalTreatsNeededForHive = totalTreatsNeededForHive + treatsForBee
        end
    end

    local approxHoney = totalTreatsNeededForHive * 10000
    TotalHiveBondLabel.Text = string.format("⚡ Tổng Bond thiếu (Lv.%d): %s", 
        targetLvl, formatFullNumber(totalBondNeededForHive))
    TotalHiveCostLabel.Text = string.format("🍬 Cần: %s Treats (~%s Honey)", 
        formatFullNumber(totalTreatsNeededForHive), formatShortNumber(approxHoney))
end

TargetInput.FocusLost:Connect(function() updateTotalHiveCostDisplay() end)
BuffInput.FocusLost:Connect(function()
    local clean = BuffInput.Text:gsub("[^%d]", "")
    local val = tonumber(clean)
    if val then
        manualBonusPercent = val
        BuffInput.Text = "+" .. tostring(val) .. "%"
        BuffInput.TextColor3 = Color3.fromRGB(255, 205, 50)
    else
        manualBonusPercent = nil
        BuffInput.Text = "Auto"
        BuffInput.TextColor3 = Color3.fromRGB(120, 255, 140)
    end
    updateTotalHiveCostDisplay()
end)

