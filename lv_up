local BOND_REQUIREMENTS = {
    [1] = 0,
    [2] = 10,
    [3] = 100,
    [4] = 500,
    [5] = 2500,
    [6] = 10000,
    [7] = 50000,
    [8] = 250000,
    [9] = 1000000,
    [10] = 5000000,
    [11] = 25000000,
    [12] = 100000000,
    [13] = 500000000,
