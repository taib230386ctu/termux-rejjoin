local cellUIElements = {}
local selectedSlotIdx = nil

local function renderGrid()
    GridContainer:ClearAllChildren()
    cellUIElements = {}

    scanHiveVisuals()

    local bees, treats, bonusPct = getParsedHoneycomb()
    liveParsedBees = bees

    if not manualBonusPercent then
        BuffInput.Text = "+" .. tostring(bonusPct) .. "%"
    end

    HeaderTitle.Text = string.format("🐝 Honeycomb Dashboard | 🍬 Treat: %s", formatFullNumber(treats))

    local loadedCount = 0
    local giftedCount = 0

    for row = 10, 1, -1 do
        local displayY = 10 - row
        for col = 1, 5 do
            local displayX = col - 1
            local slotIdx = (row - 1) * 5 + col
            local bee = bees[slotIdx]

            local cellBox = Instance.new("TextButton")
            cellBox.Text = ""
            cellBox.Size = UDim2.new(0.188, 0, 0.088, 0)
            cellBox.Position = UDim2.new(0.01 + displayX * 0.198, 0, 0.01 + displayY * 0.098, 0)
            cellBox.BorderSizePixel = 0
            cellBox.Parent = GridContainer
            Instance.new("UICorner", cellBox).CornerRadius = UDim.new(0, 4)

            local stroke = Instance.new("UIStroke", cellBox)
            stroke.Thickness = 1.2
            stroke.Color = Color3.fromRGB(45, 45, 55)

            local bondBarBg = Instance.new("Frame")
            bondBarBg.Size = UDim2.new(1, -4, 0, 3)
            bondBarBg.Position = UDim2.new(0, 2, 1, -4)
            bondBarBg.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
            bondBarBg.BorderSizePixel = 0
            bondBarBg.Parent = cellBox
            Instance.new("UICorner", bondBarBg).CornerRadius = UDim.new(1, 0)

            local bondBarFill = Instance.new("Frame")
            bondBarFill.Size = UDim2.new(0, 0, 1, 0)
            bondBarFill.BackgroundColor3 = Color3.fromRGB(255, 205, 50)
            bondBarFill.BorderSizePixel = 0
            bondBarFill.Parent = bondBarBg
            Instance.new("UICorner", bondBarFill).CornerRadius = UDim.new(1, 0)

            local faceImage = Instance.new("ImageLabel")
            faceImage.Size = UDim2.new(0, 16, 0, 16)
            faceImage.Position = UDim2.new(0, 2, 0, 2)
            faceImage.BackgroundTransparency = 1
            faceImage.ScaleType = Enum.ScaleType.Fit
            faceImage.Visible = false
            faceImage.Parent = cellBox

            local typeLabel = Instance.new("TextLabel")
            typeLabel.Size = UDim2.new(0, 24, 0, 16)
            typeLabel.Position = UDim2.new(0, 19, 0, 2)
            typeLabel.Font = Enum.Font.SourceSansBold
            typeLabel.TextSize = 8
            typeLabel.TextTruncate = Enum.TextTruncate.AtEnd
            typeLabel.TextXAlignment = Enum.TextXAlignment.Left
            typeLabel.BackgroundTransparency = 1
            typeLabel.Parent = cellBox

            local lvlLabel = Instance.new("TextLabel")
            lvlLabel.Size = UDim2.new(0, 12, 0, 16)
            lvlLabel.Position = UDim2.new(1, -13, 0, 2)
            lvlLabel.Font = Enum.Font.SourceSansBold
            lvlLabel.TextSize = 9
            lvlLabel.TextXAlignment = Enum.TextXAlignment.Right
            lvlLabel.BackgroundTransparency = 1
            lvlLabel.Parent = cellBox

            if bee then
                loadedCount = loadedCount + 1
                cellBox.BackgroundColor3 = bee.CellColor:Lerp(Color3.fromRGB(20, 20, 24), 0.55)
                lvlLabel.Text = tostring(bee.Lvl)
                lvlLabel.TextColor3 = (bee.Lvl >= 15) and Color3.fromRGB(100, 255, 120) or Color3.fromRGB(255, 255, 255)

                if bee.IsGifted then
                    giftedCount = giftedCount + 1
                    stroke.Color = Color3.fromRGB(255, 215, 0)
                    stroke.Thickness = 1.6
                    typeLabel.TextColor3 = Color3.fromRGB(255, 225, 75)
                    typeLabel.Text = "★" .. tostring(bee.Type)
                else
                    stroke.Color = Color3.fromRGB(45, 45, 55)
                    stroke.Thickness = 1.2
                    typeLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
                    typeLabel.Text = tostring(bee.Type)
                end

                if bee.FaceIcon and bee.FaceIcon ~= "" then
                    faceImage.Image = bee.FaceIcon
                    faceImage.Visible = true
                    typeLabel.Position = UDim2.new(0, 19, 0, 2)
                    typeLabel.Size = UDim2.new(0, 24, 0, 16)
                else
                    faceImage.Visible = false
                    typeLabel.Position = UDim2.new(0, 3, 0, 2)
                    typeLabel.Size = UDim2.new(0, 38, 0, 16)
                end

                local pct = math.clamp(bee.CurBond / bee.MaxBond, 0, 1)
                bondBarFill.Size = UDim2.new(pct, 0, 1, 0)
                bondBarFill.BackgroundColor3 = (pct >= 0.8) and Color3.fromRGB(100, 255, 120) or Color3.fromRGB(255, 205, 50)
            else
                cellBox.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
                typeLabel.Text = ""
                lvlLabel.Text = ""
                faceImage.Visible = false
            end

            cellBox.MouseButton1Click:Connect(function()
                selectedSlotIdx = slotIdx
                local b = liveParsedBees[slotIdx]
                if b then
                    local currentBuff = manualBonusPercent or bonusPct
                    local bondPerTreat = 10 * (1 + (currentBuff / 100))
                    local missingBond = math.max(0, b.MaxBond - b.CurBond)
                    local missingTreats = math.ceil(missingBond / bondPerTreat)
                    local nextLvl = b.Lvl + 1
                    local tag = b.IsGifted and " [★ Gifted]" or ""

                    DetailBeeTitle.Text = string.format("🐝 C%d,%d: %s%s (Lv.%d ➔ %d)", b.Col, b.Row, tostring(b.Type), tag, b.Lvl, nextLvl)
                    DetailBondText.Text = string.format("Bond: %s / %s\nThiếu: %s Treats [Moon: +%d%%]", 
                        formatFullNumber(b.CurBond), formatFullNumber(b.MaxBond), formatFullNumber(missingTreats), currentBuff)
                else
                    DetailBeeTitle.Text = string.format("🐝 Ô %d: (Ô Trống)", slotIdx)
                    DetailBondText.Text = "Chưa có thông tin con ong."
                end
            end)

            cellUIElements[slotIdx] = {
                Box = cellBox,
                Stroke = stroke,
                TypeLabel = typeLabel,
                LevelLabel = lvlLabel,
                BarFill = bondBarFill,
                FaceImage = faceImage
            }
        end
    end

    updateTotalHiveCostDisplay(bees)
    LiveStatusLabel.Text = string.format("✅ Tải %d con ong (%d Gifted Bee ★)! Moon: +%d%%.", loadedCount, giftedCount, bonusPct)
    LiveStatusLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
end

