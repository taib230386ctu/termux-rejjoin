                    ui.TypeLabel.Text = "★" .. tostring(b.Type)
                else
                    ui.TypeLabel.Text = tostring(b.Type)
                end

                if b.FaceIcon and b.FaceIcon ~= "" and (not ui.FaceImage.Visible or ui.FaceImage.Image ~= b.FaceIcon) then
                    ui.FaceImage.Image = b.FaceIcon
                    ui.FaceImage.Visible = true
                    ui.TypeLabel.Position = UDim2.new(0, 19, 0, 2)
                    ui.TypeLabel.Size = UDim2.new(0, 24, 0, 16)
                end
                local pct = math.clamp(b.CurBond / b.MaxBond, 0, 1)
                ui.BarFill.Size = UDim2.new(pct, 0, 1, 0)
                ui.BarFill.BackgroundColor3 = (pct >= 0.8) and Color3.fromRGB(100, 255, 120) or Color3.fromRGB(255, 205, 50)
            end
        end

        if selectedSlotIdx and liveParsedBees[selectedSlotIdx] then
            local b = liveParsedBees[selectedSlotIdx]
            local currentBuff = manualBonusPercent or bonusPct
            local bondPerTreat = 10 * (1 + (currentBuff / 100))
            local missingBond = math.max(0, b.MaxBond - b.CurBond)
            local missingTreats = math.ceil(missingBond / bondPerTreat)
            local nextLvl = b.Lvl + 1
            local tag = b.IsGifted and " [★ Gifted]" or ""

            DetailBeeTitle.Text = string.format("🐝 C%d,%d: %s%s (Lv.%d ➔ %d)", b.Col, b.Row, tostring(b.Type), tag, b.Lvl, nextLvl)
            DetailBondText.Text = string.format("Bond: %s / %s\nThiếu: %s Treats [Moon: +%d%%]", 
                formatFullNumber(b.CurBond), formatFullNumber(b.MaxBond), formatFullNumber(missingTreats), currentBuff)
        end

        updateTotalHiveCostDisplay(bees)
        task.wait(1)
    end
end)

