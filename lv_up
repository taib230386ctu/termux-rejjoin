-- ==================== CHU TRÌNH TỰ ĐỘNG ====================
local isRunning = false
local farmPos = nil

RunAutoBtn.MouseButton1Click:Connect(function()
    if isRunning then return end

    local targetLvl = tonumber(TargetInput.Text)

    if not targetLvl or targetLvl < 2 or targetLvl > 25 then
        LiveStatusLabel.Text = "⚠️ Cấp mục tiêu không hợp lệ!"
        LiveStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    if not cachedHiveCFrame then
        local myHive = getMyHiveInstance()
        if myHive then
            local base = myHive:FindFirstChild("Platform") or myHive:FindFirstChildWhichIsA("BasePart")
            if base then cachedHiveCFrame = base.CFrame * CFrame.new(0, 4, 10) end
        end
    end

    if not cachedHiveCFrame then
        LiveStatusLabel.Text = "❌ Chưa lưu vị trí tổ! Đứng trước tổ bấm nút vàng 1 lần."
        LiveStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    local _, treatsNow = getParsedHoneycomb()
    if treatsNow <= 0 then
        LiveStatusLabel.Text = "🛑 CHẶN BAY: Hết sạch Treats trong túi! Ở lại bãi farm."
        LiveStatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    farmPos = hrp.CFrame

    isRunning = true
    RunAutoBtn.Text = "⚡ Đang chạy..."
    RunAutoBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 20)

    task.spawn(function()
        LiveStatusLabel.Text = "🚀 Đang bay về tổ..."
        LiveStatusLabel.TextColor3 = Color3.fromRGB(255, 205, 50)
        tweenTo(cachedHiveCFrame, 65)
        task.wait(0.5)

        local upgradedCount = 0
        local treatDepleted = false

        for slotIdx = 1, 50 do
            if not isRunning or treatDepleted then break end

            local bee = liveParsedBees[slotIdx]
            if bee and bee.Lvl and bee.Lvl < targetLvl then
                local ui = cellUIElements[slotIdx]
                if ui then ui.Stroke.Color = Color3.fromRGB(255, 205, 50) end

                while isRunning and bee.Lvl < targetLvl do
                    local _, curTreats, bonusPct = getParsedHoneycomb()
                    if curTreats <= 0 then
                        treatDepleted = true
                        LiveStatusLabel.Text = "⚠️ Hết sạch Treats! Đang tự bay về bãi farm..."
                        LiveStatusLabel.TextColor3 = Color3.fromRGB(255, 160, 50)
                        break
                    end

                    local currentBuff = manualBonusPercent or bonusPct
                    local bondPerTreat = 10 * (1 + (currentBuff / 100))

                    local targetCumulativeBond = CumulativeBondToReachLvl[targetLvl] or (CumulativeBondToReachLvl[#CumulativeBondToReachLvl])
                    local totalBondNeeded = math.max(0, targetCumulativeBond - bee.TotalBond)
                    local exactTreatsNeeded = math.ceil(totalBondNeeded / bondPerTreat)

                    local feedAmount = math.min(curTreats, exactTreatsNeeded)

                    LiveStatusLabel.Text = string.format("🐝 Nạp ô C%d,%d (%s Lv.%d ➔ Lv.%d): Nạp %s Treats...", 
                        bee.Col, bee.Row, tostring(bee.Type), bee.Lvl, targetLvl, formatFullNumber(feedAmount))
                    LiveStatusLabel.TextColor3 = Color3.fromRGB(120, 255, 140)

                    sendFeed(bee.Col, bee.Row, bee.RawCellName, feedAmount)
                    task.wait(0.6)

                    local freshBees, _ = getParsedHoneycomb()
                    local newBee = freshBees[slotIdx]
                    if newBee then
                        bee = newBee
                        liveParsedBees[slotIdx] = newBee
                        if ui then
                            ui.LevelLabel.Text = tostring(newBee.Lvl)
                            ui.LevelLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
                        end
                        if bee.Lvl >= targetLvl then
                            upgradedCount = upgradedCount + 1
                            break
                        end
                    end

                    if feedAmount >= curTreats then
                        treatDepleted = true
                        LiveStatusLabel.Text = "⚠️ Đã dùng hết Treat trong túi! Đang quay lại bãi farm..."
                        LiveStatusLabel.TextColor3 = Color3.fromRGB(255, 160, 50)
                        break
                    end
                end

                if ui then 
                    ui.Stroke.Color = bee.IsGifted and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(45, 45, 55)
                end
            end
        end

        if farmPos then
            if treatDepleted then
                LiveStatusLabel.Text = "✈️ Hết Treats, đang quay lại bãi farm..."
            else
                LiveStatusLabel.Text = "✈️ Hoàn tất! Đang bay về lại bãi farm..."
            end
            LiveStatusLabel.TextColor3 = Color3.fromRGB(100, 220, 255)
            tweenTo(farmPos, 65)
        end

        if treatDepleted then
            LiveStatusLabel.Text = string.format("🛑 Đã dừng do hết Treat (Đã nâng %d con lên Lv.%d)", upgradedCount, targetLvl)
            LiveStatusLabel.TextColor3 = Color3.fromRGB(255, 180, 80)
        else
            LiveStatusLabel.Text = string.format("✅ Xong! Đã nâng %d con lên thẳng Lv.%d.", upgradedCount, targetLvl)
            LiveStatusLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
        end

        isRunning = false
        RunAutoBtn.Text = "🚀 Bay Về Tổ & Nạp Đủ Lv"
        RunAutoBtn.BackgroundColor3 = Color3.fromRGB(40, 170, 70)
    end)
end)

StopAutoBtn.MouseButton1Click:Connect(function()
    if not isRunning then return end
    isRunning = false
    LiveStatusLabel.Text = "🛑 Đang dừng! Bay lại bãi farm..."
    LiveStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    task.spawn(function()
        if farmPos then tweenTo(farmPos, 65) end
        LiveStatusLabel.Text = "Đã dừng tại bãi farm."
        RunAutoBtn.Text = "🚀 Bay Về Tổ & Nạp Đủ Lv"
        RunAutoBtn.BackgroundColor3 = Color3.fromRGB(40, 170, 70)
    end)
end)
