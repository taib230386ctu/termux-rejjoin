    [17] = 250000000000,
    [18] = 1000000000000,
    [19] = 5000000000000,
    [20] = 25000000000000,
    [21] = 100000000000000,
    [22] = 500000000000000,
    [23] = 2500000000000000,
    [24] = 10000000000000000,
    [25] = 50000000000000000
}

-- Safe Module Fetch
local function getStatCache()
    local clientStatCache = ReplicatedStorage:FindFirstChild("ClientStatCache")
    if clientStatCache then
        local success, result = pcall(require, clientStatCache)
        if success then return result end
    end
    return nil
end

-- =================================================================
-- 1. HÀM QUÉT SÂU BÙA MOON AMULET
-- =================================================================
local function getAtlasMoonTreatBonus()
    local StatCache = getStatCache()
    if not StatCache then
        return false, 0, "Không tìm thấy ClientStatCache"
    end

    local s, myData = pcall(function() return StatCache:Get() end)
    if not s or type(myData) ~= "table" then
        return false, 0, "Không đọc được StatCache"
    end

    local moonObj = nil
    if myData.Amulets and myData.Amulets.Moon then
        moonObj = myData.Amulets.Moon
    elseif myData.AmuletData and myData.AmuletData.Moon then
        moonObj = myData.AmuletData.Moon
    elseif myData.EquippedAmulets and myData.EquippedAmulets.Moon then
        moonObj = myData.EquippedAmulets.Moon
    end

    if not moonObj then 
        return false, 0, "Chưa trang bị Moon Amulet"
    end

    local treatPercent = 0
    local foundStatName = ""

    local function parseItem(k, v)
        local kStr = tostring(k):lower()
        if (kStr:find("treat") or kStr:find("bondfromtreats")) and (type(v) == "number" or tonumber(v)) then
            local num = tonumber(v) or 0
            if num > 0 then
                treatPercent = (num < 1) and (num * 100) or num
                foundStatName = tostring(k)
            end
        elseif type(v) == "table" then
            local statName = tostring(v[1] or v.Name or v.Stat or v.Type or v.Key or "")
            local statVal = tonumber(v[2] or v.Value or v.Amount or v.Num) or 0
            local nameLower = statName:lower()
            if nameLower:find("treat") or nameLower:find("bond") then
                if statVal > 0 then
                    treatPercent = (statVal < 1) and (statVal * 100) or statVal
                    foundStatName = statName
                end
            end
        end
    end

    if type(moonObj) == "table" then
        for k, v in pairs(moonObj) do
            parseItem(k, v)
            if type(v) == "table" then
                for subK, subV in pairs(v) do
                    parseItem(subK, subV)
                end
            end
        end
    end

    if treatPercent > 0 then
        return true, treatPercent, "Tìm thấy: " .. foundStatName
    end

    return true, 0, "Moon Amulet không có dòng Bond From Treats"
end

-- Tính tổng Bond từ Lvl hiện tại -> Target Lvl
local function getBondRequired(currentLvl, targetLvl)
    if targetLvl <= currentLvl then return 0 end
    local total = 0
    for lvl = currentLvl + 1, targetLvl do
        total = total + (BOND_REQUIREMENTS[lvl] or 0)
    end
    return total
end

