            lvlLabel.Parent = cellBox

            if bee then
                loadedCount = loadedCount + 1
                cellBox.BackgroundColor3 = bee.CellColor:Lerp(Color3.fromRGB(20, 20, 24), 0.55)
                lvlLabel.Text = tostring(bee.Lvl)
                lvlLabel.TextColor3 = (bee.Lvl >= 15) and Color3.fromRGB(100, 255, 120) or Color3.fromRGB(255, 255, 255)

                -- HIỂN THỊ NỔI BẬT NẾU LÀ GIFTED
                if bee.IsGifted then
                    giftedCount = giftedCount + 1
                    stroke.Color = Color3.fromRGB(255, 215, 0)
                    stroke.Thickness = 1.8
                    typeLabel.TextColor3 = Color3.fromRGB(255, 225, 75)
                    typeLabel.Text = "★" .. tostring(bee.Type)
                else
                    stroke.Color = Color3.fromRGB(45, 45, 55)
                    stroke.Thickness = 1.2
                    typeLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
                    typeLabel.Text = tostring(bee.Type)
                end

                if bee.FaceIcon and bee.FaceIcon ~= "" then
                    faceImage.Image = bee.FaceIcon
                    faceImage.Visible = true
                    typeLabel.Position = UDim2.new(0, 21, 0, 2)
                    typeLabel.Size = UDim2.new(0, 24, 0, 18)
                else
                    faceImage.Visible = false
                    typeLabel.Position = UDim2.new(0, 3, 0, 2)
                    typeLabel.Size = UDim2.new(0, 40, 0, 18)
                end

                local pct = math.clamp(bee.CurBond / bee.MaxBond, 0, 1)
                bondBarFill.Size = UDim2.new(pct, 0, 1, 0)
                bondBarFill.BackgroundColor3 = (pct >= 0.8) and Color3.fromRGB(100, 255, 120) or Color3.fromRGB(255, 205, 50)
            else
                cellBox.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
                typeLabel.Text = ""
                lvlLabel.Text = ""
                faceImage.Visible = false
            end

            cellBox.MouseButton1Click:Connect(function()
                selectedSlotIdx = slotIdx
                local b = liveParsedBees[slotIdx]
                if b then
                    local currentBuff = manualBonusPercent or bonusPct
                    local bondPerTreat = 10 * (1 + (currentBuff / 100))
                    local missingBond = math.max(0, b.MaxBond - b.CurBond)
                    local missingTreats = math.ceil(missingBond / bondPerTreat)
                    local nextLvl = b.Lvl + 1
                    local tag = b.IsGifted and " [★ Gifted]" or ""

                    DetailBeeTitle.Text = string.format("🐝 Ô C%d,%d: %s%s (Lv.%d ➔ Lv.%d)", b.Col, b.Row, tostring(b.Type), tag, b.Lvl, nextLvl)
                    DetailBondText.Text = string.format("Bond: %s / %s (Thiếu: %s Treats [Moon: +%d%%])", 
                        formatFullNumber(b.CurBond), formatFullNumber(b.MaxBond), formatFullNumber(missingTreats), currentBuff)
                else
                    DetailBeeTitle.Text = string.format("🐝 Ô %d: (Ô Trống)", slotIdx)
                    DetailBondText.Text = "Chưa có thông tin con ong."
                end
            end)

            cellUIElements[slotIdx] = {
                Box = cellBox,
                Stroke = stroke,
                TypeLabel = typeLabel,
                LevelLabel = lvlLabel,
                BarFill = bondBarFill,
                FaceImage = faceImage
            }
        end
    end

    LiveStatusLabel.Text = string.format("✅ Tải %d con ong (%d Gifted Bee ★)! Moon: +%d%%.", loadedCount, giftedCount, bonusPct)
    LiveStatusLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
end

