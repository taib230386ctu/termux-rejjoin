local function formatFullNumber(n)
    if not n then return "0" end
    local formatted = tostring(math.floor(n))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

-- ==================== LOGIC QUÉT ẢNH & KIỂM TRA GIFTED TỪ WORKSPACE ====================
local function getMyHiveInstance()
    local hives = Workspace:FindFirstChild("Honeycombs") or Workspace:FindFirstChild("Hives")
    if not hives then return nil end

    for _, hive in ipairs(hives:GetChildren()) do
        local owner = hive:FindFirstChild("Owner")
        if owner and (owner.Value == LocalPlayer or tostring(owner.Value) == LocalPlayer.Name or owner.Value == LocalPlayer.UserId) then
            return hive
        end
    end

    for _, hive in ipairs(hives:GetChildren()) do
        for _, desc in ipairs(hive:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text == LocalPlayer.Name then
                return hive
            end
        end
    end

    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        local closest, minDist = nil, 40
        for _, hive in ipairs(hives:GetChildren()) do
            local base = hive:FindFirstChild("Platform") or hive:FindFirstChildWhichIsA("BasePart")
            if base and (base.Position - myPos).Magnitude < minDist then
                minDist = (base.Position - myPos).Magnitude
                closest = hive
            end
        end
        if closest then return closest end
    end
    return nil
end

local function parseSlotPosition(slotName)
    local c, r = string.match(slotName, "(%d+)%s*[,_x-]%s*(%d+)")
    if c and r then return tonumber(c), tonumber(r) end
    local index = tonumber(string.match(slotName, "%d+"))
    if index and index >= 1 and index <= 50 then
        return ((index - 1) % 5) + 1, math.floor((index - 1) / 5) + 1
    end
    return nil, nil
end

local function extractCellVisual(cell)
    local imgId = nil
    local cellColor = nil
    local isCellGifted = false

    if cell:IsA("BasePart") then cellColor = cell.Color
    else
        local p = cell:FindFirstChildWhichIsA("BasePart", true)
        if p then cellColor = p.Color end
    end
    if not cellColor then cellColor = Color3.fromRGB(40, 40, 48) end

    local foundImages = {}
    for _, desc in ipairs(cell:GetDescendants()) do
        local lower = desc.Name:lower()
        if lower:find("gift") or lower:find("star") or lower:find("sparkle") then
            isCellGifted = true
        end

        if desc:IsA("Decal") and desc.Texture ~= "" then
            if lower:find("face") or lower:find("front") or lower:find("bee") then
                imgId = desc.Texture
            else
                table.insert(foundImages, desc.Texture)
            end
        elseif desc:IsA("ImageLabel") and desc.Image ~= "" then
            if lower:find("face") or lower:find("front") or lower:find("bee") then
                imgId = desc.Image
            else
                table.insert(foundImages, desc.Image)
            end
        end
    end

    if not imgId and #foundImages > 0 then
        imgId = (#foundImages >= 2) and foundImages[2] or foundImages[1]
    end

    return imgId, cellColor, isCellGifted
end

local workspaceVisualCache = {}

local function scanHiveVisuals()
    local myHive = getMyHiveInstance()
    if not myHive then return end

    local cellsFolder = myHive:FindFirstChild("Cells") or myHive:FindFirstChild("Slots") or myHive
    for _, cell in ipairs(cellsFolder:GetChildren()) do
        local col, row = parseSlotPosition(cell.Name)
        if col and row then
            local key = string.format("%d_%d", col, row)
            local img, colr, isGifted = extractCellVisual(cell)
            if img or colr then
                workspaceVisualCache[key] = {
                    Image = img,
                    Color = colr,
                    IsGifted = isGifted
                }
            end
        end
    end
end

-- ==================== TRÍCH XUẤT myData & LOAD MOON AMULET ====================
local StatCache = require(ReplicatedStorage:WaitForChild("ClientStatCache", 5))
local manualBonusPercent = nil

local function detectMoonAmuletBonus(myData)
    if not myData then return 0 end

    if myData.BondFromTreats and tonumber(myData.BondFromTreats) then
        return tonumber(myData.BondFromTreats)
    end
    if myData.Stats and type(myData.Stats) == "table" then
        for k, v in pairs(myData.Stats) do
            local lk = tostring(k):lower()
            if lk:find("bond") and lk:find("treat") then
                local n = tonumber(v)
                if n and n > 0 then return n end
            end
        end
    end

    if myData.Amulets and type(myData.Amulets) == "table" then
        local moon = myData.Amulets.Moon or myData.Amulets["Moon Amulet"]
        if type(moon) == "table" then
            for k, val in pairs(moon) do
                local lk = tostring(k):lower()
                if lk:find("bond") and tonumber(val) then
                    return tonumber(val)
                end
                local sVal = tostring(val)
                if sVal:lower():find("bond") then
                    local num = tonumber(sVal:match("(%d+)%%?"))
                    if num then return num end
                end
            end
        end
    end

    return 0
end

local function getParsedHoneycomb()
    local s, myData = pcall(function() return StatCache:Get() end)
    if not s or type(myData) ~= "table" then return {}, 0, 0 end

    local treats = (myData.Eggs and tonumber(myData.Eggs.Treat)) or 0
    local honeycomb = myData.Honeycomb or {}
    local parsed = {}

    local autoBonus = detectMoonAmuletBonus(myData)
    local finalBonus = manualBonusPercent or autoBonus

    for col = 1, 5 do
        local colKey = "x" .. col
        local colData = honeycomb[colKey] or honeycomb[col]

        if type(colData) == "table" then
            for row = 1, 10 do
                local rowKey = "y" .. row
                local bee = colData[rowKey] or colData[row]

                if type(bee) == "table" and bee.Type then
                    local idx = (row - 1) * 5 + col
                    local totalLifetimeBond = tonumber(bee.Bond) or 0
                    local currentLvl = tonumber(bee.Lvl or bee.Level) or 1
                    local beeType = tostring(bee.Type or "Bee")

                    local baseBondOfThisLvl = CumulativeBondToReachLvl[currentLvl] or 0
                    local currentLvlBond = math.max(0, totalLifetimeBond - baseBondOfThisLvl)
                    local bondRequiredForNextLvl = StepBondForLvl[currentLvl] or 15000

                    local vKey = string.format("%d_%d", col, row)
                    local visual = workspaceVisualCache[vKey]

                    -- NHẬN DIỆN GIFTED ĐA TẦNG:
                    local isGifted = false
                    if bee.Gifted == true or bee.gifted == true or bee.Gift == true then
                        isGifted = true
                    elseif bee.Variant and tostring(bee.Variant):lower():find("gifted") then
                        isGifted = true
                    elseif bee.Type and tostring(bee.Type):lower():find("gifted") then
                        isGifted = true
                    elseif visual and visual.IsGifted then
                        isGifted = true
                    end

                    parsed[idx] = {
                        Col = col,
                        Row = row,
                        Slot = idx,
                        Type = beeType,
                        Lvl = currentLvl,
                        TotalBond = totalLifetimeBond,
                        CurBond = currentLvlBond,
                        MaxBond = bondRequiredForNextLvl,
                        RawCellName = string.format("C%d,%d", col, row),
                        FaceIcon = visual and visual.Image,
                        CellColor = visual and visual.Color or Color3.fromRGB(35, 38, 48),
                        IsGifted = isGifted
                    }
                end
            end
        end
    end

    return parsed, treats, finalBonus
end

-- ==================== TWEEN & FEED ====================
local cachedHiveCFrame = nil

local function tweenTo(targetCFrame, speed)
    speed = speed or 65
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local duration = math.clamp(distance / speed, 0.5, 15)

    local bodyV = Instance.new("BodyVelocity")
    bodyV.Velocity = Vector3.zero
    bodyV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyV.Parent = hrp

    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
    tween:Play()
    tween.Completed:Wait()

    bodyV:Destroy()
end

local function sendFeed(col, row, cellName, amount)
    pcall(function()
        ReplicatedStorage.Events.ConstructHiveCellFromEgg:InvokeServer(col, row, "Treat", amount)
    end)
    pcall(function()
        ReplicatedStorage.Events.PlayerActivesCommand:FireServer({
            ["Name"] = "Feed",
            ["Item"] = "Treat",
            ["Cell"] = cellName,
            ["Amount"] = amount
        })
    end)
end

