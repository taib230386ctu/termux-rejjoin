-- 3. XỬ LÝ LOGIC CHÍNH (QUÉT HIVE & CHO ĂN AUTO)
-- =================================================================
local currentMoonBonusPercent = 0

local function refreshMoonBonus()
    local success, percent, status = getAtlasMoonTreatBonus()
    if success then
        currentMoonBonusPercent = percent
        if percent > 0 then
            MoonStatusLabel.Text = string.format("🌙 Moon Bonus: +%.0f%% Bond From Treats (1 Treat = %.1f Bond)", percent, 10 * (1 + percent/100))
            MoonStatusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
        else
            MoonStatusLabel.Text = "🌙 Moon Bonus: 0% (1 Treat = 10 Bond)"
            MoonStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
        end
    else
        MoonStatusLabel.Text = "❌ Lỗi: " .. status
        MoonStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

local function scanHiveAndRender()
    refreshMoonBonus()

    -- Xóa các item cũ
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local StatCache = getStatCache()
    if not StatCache then
        LogLabel.Text = "❌ Không tìm thấy ClientStatCache!"
        return
    end

    local s, myData = pcall(function() return StatCache:Get() end)
    if not s or type(myData) ~= "table" or not myData.Bees then
        LogLabel.Text = "❌ Không tìm thấy dữ liệu Bees trong StatCache!"
        return
    end

    local targetLvl = tonumber(TargetInput.Text) or 12
    local bondPerTreat = 10 * (1 + (currentMoonBonusPercent / 100))
    local totalTreatsInInventory = myData.Treats or 0

    local beeCount = 0

    for slotIndex, beeData in pairs(myData.Bees) do
        beeCount = beeCount + 1
        local beeName = beeData.Type or "Bee"
        local currentLvl = beeData.Level or 1
        local currentBond = beeData.Bond or 0

        -- Tính toán lượng Treat cần dùng
        local totalBondNeeded = getBondRequired(currentLvl, targetLvl)
        local remainingBondNeeded = math.max(0, totalBondNeeded - currentBond)
        local treatsNeeded = math.ceil(remainingBondNeeded / bondPerTreat)

        -- Item Frame cho từng con ong
        local BeeItem = Instance.new("Frame")
        BeeItem.Size = UDim2.new(1, -10, 0, 36)
        BeeItem.BackgroundColor3 = Color3.fromRGB(32, 32, 44)
        BeeItem.Parent = ScrollFrame
        Instance.new("UICorner", BeeItem).CornerRadius = UDim.new(0, 4)

        local BeeInfo = Instance.new("TextLabel")
        BeeInfo.Size = UDim2.new(0.65, 0, 1, 0)
        BeeInfo.Position = UDim2.new(0, 8, 0, 0)
        BeeInfo.Text = string.format("[%d] %s (Lv.%d) ➜ Lv.%d\nCần: %s Treats", slotIndex, beeName, currentLvl, targetLvl, tostring(treatsNeeded))
        BeeInfo.TextColor3 = Color3.fromRGB(240, 240, 240)
        BeeInfo.Font = Enum.Font.SourceSans
        BeeInfo.TextSize = 12
        BeeInfo.TextXAlignment = Enum.TextXAlignment.Left
        BeeInfo.BackgroundTransparency = 1
        BeeInfo.Parent = BeeItem

        local FeedBtn = Instance.new("TextButton")
        FeedBtn.Size = UDim2.new(0.3, -8, 0, 26)
        FeedBtn.Position = UDim2.new(0.7, 0, 0, 5)
        FeedBtn.Text = (currentLvl >= targetLvl) and "Đạt Max" or "Cho Ăn"
        FeedBtn.BackgroundColor3 = (currentLvl >= targetLvl) and Color3.fromRGB(60, 60, 75) or Color3.fromRGB(50, 180, 100)
        FeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        FeedBtn.Font = Enum.Font.SourceSansBold
        FeedBtn.TextSize = 12
        FeedBtn.Parent = BeeItem
        Instance.new("UICorner", FeedBtn).CornerRadius = UDim.new(0, 4)

        -- Sự kiện Nút Cho Ăn Tự Động
        FeedBtn.MouseButton1Click:Connect(function()
            if currentLvl >= targetLvl then
                LogLabel.Text = "⚠️ Ong đã đạt hoặc vượt Level mục tiêu!"
                return
            end

            if treatsNeeded <= 0 then
                LogLabel.Text = "⚠️ Ong không cần thêm Treat!"
                return
            end

            LogLabel.Text = string.format("⌛ Đang cho [%s] ăn %d Treats...", beeName, treatsNeeded)
            FeedBtn.Text = "Đang xử lý..."
            FeedBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 50)

            -- Gửi Remote Event tới Server để nâng cấp Ong
            task.spawn(function()
                local ConstructHiveEvent = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("ConstructHiveEvent")
                if ConstructHiveEvent then
                    ConstructHiveEvent:FireServer("Feed", treatsNeeded, "Treat", slotIndex)
                    task.wait(1)
                    scanHiveAndRender()
                    LogLabel.Text = string.format("✅ Đã gửi Remote nâng Level thành công cho [%s]!", beeName)
                else
                    LogLabel.Text = "❌ Không tìm thấy ConstructHiveEvent!"
                end
            end)
        end)
    end

    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, beeCount * 40)
    LogLabel.Text = string.format("Quét thành công %d chú ong. Treat hiện có: %d", beeCount, totalTreatsInInventory)
end

