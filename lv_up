local activeResizeCorner = nil
local rStartMousePos = Vector2.zero
local rStartFramePos = Vector2.zero
local rStartFrameSize = Vector2.zero

local function createCornerGrip(name, pos, anchor, symbol)
    local grip = Instance.new("TextButton")
    grip.Name = name
    grip.Size = UDim2.new(0, 16, 0, 16)
    grip.Position = pos
    grip.AnchorPoint = anchor
    grip.BackgroundColor3 = Color3.fromRGB(38, 38, 46)
    grip.Text = symbol
    grip.TextColor3 = Color3.fromRGB(255, 205, 50)
    grip.Font = Enum.Font.SourceSansBold
    grip.TextSize = 10
    grip.ZIndex = 25
    grip.AutoButtonColor = false
    grip.Parent = MainFrame
    Instance.new("UICorner", grip).CornerRadius = UDim.new(0, 3)

    grip.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            activeResizeCorner = name
            rStartMousePos = Vector2.new(input.Position.X, input.Position.Y)
            rStartFramePos = Vector2.new(MainFrame.AbsolutePosition.X, MainFrame.AbsolutePosition.Y)
            rStartFrameSize = Vector2.new(MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y)
            MainFrame.Draggable = false
        end
    end)
end

createCornerGrip("Grip_TL", UDim2.new(0, 0, 0, 0), Vector2.new(0, 0), "◤")
createCornerGrip("Grip_TR", UDim2.new(1, 0, 0, 0), Vector2.new(1, 0), "◥")
createCornerGrip("Grip_BL", UDim2.new(0, 0, 1, 0), Vector2.new(0, 1), "◣")
createCornerGrip("Grip_BR", UDim2.new(1, 0, 1, 0), Vector2.new(1, 1), "◢")

UserInputService.InputChanged:Connect(function(input)
    if activeResizeCorner and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local deltaX = input.Position.X - rStartMousePos.X
        local deltaY = input.Position.Y - rStartMousePos.Y
        local minW, maxW = 500, 1050
        local minH, maxH = 280, 650

        if activeResizeCorner == "Grip_BR" then
            local newW = math.clamp(rStartFrameSize.X + deltaX, minW, maxW)
            local newH = math.clamp(rStartFrameSize.Y + deltaY, minH, maxH)
            MainFrame.Size = UDim2.new(0, newW, 0, newH)
        elseif activeResizeCorner == "Grip_BL" then
            local newW = math.clamp(rStartFrameSize.X - deltaX, minW, maxW)
            local newH = math.clamp(rStartFrameSize.Y + deltaY, minH, maxH)
            local newPosX = rStartFramePos.X + (rStartFrameSize.X - newW)
            MainFrame.Size = UDim2.new(0, newW, 0, newH)
            MainFrame.Position = UDim2.new(0, newPosX, 0, rStartFramePos.Y)
        elseif activeResizeCorner == "Grip_TR" then
            local newW = math.clamp(rStartFrameSize.X + deltaX, minW, maxW)
            local newH = math.clamp(rStartFrameSize.Y - deltaY, minH, maxH)
            local newPosY = rStartFramePos.Y + (rStartFrameSize.Y - newH)
            MainFrame.Size = UDim2.new(0, newW, 0, newH)
            MainFrame.Position = UDim2.new(0, rStartFramePos.X, 0, newPosY)
        elseif activeResizeCorner == "Grip_TL" then
            local newW = math.clamp(rStartFrameSize.X - deltaX, minW, maxW)
            local newH = math.clamp(rStartFrameSize.Y - deltaY, minH, maxH)
            local newPosX = rStartFramePos.X + (rStartFrameSize.X - newW)
            local newPosY = rStartFramePos.Y + (rStartFrameSize.Y - newH)
            MainFrame.Size = UDim2.new(0, newW, 0, newH)
            MainFrame.Position = UDim2.new(0, newPosX, 0, newPosY)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        activeResizeCorner = nil
        MainFrame.Draggable = true
    end
end)

