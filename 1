local function formatNumber(n)
    if not n then return "0" end
    local formatted = tostring(math.floor(n))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

local function getMyHiveInstance()
    local hives = Workspace:FindFirstChild("Honeycombs") or Workspace:FindFirstChild("Hives")
    if not hives then return nil end
    for _, hive in ipairs(hives:GetChildren()) do
        local owner = hive:FindFirstChild("Owner")
        if owner and (owner.Value == LocalPlayer or tostring(owner.Value) == LocalPlayer.Name or owner.Value == LocalPlayer.UserId) then
            return hive
        end
    end
    return nil
end

local function parseSlotPosition(slotName)
    local c, r = string.match(slotName, "(%d+)%s*[,_x:-]%s*(%d+)")
    if c and r then return tonumber(c), tonumber(r) end
    local index = tonumber(string.match(slotName, "%d+"))
    if index and index >= 1 and index <= 50 then
        return ((index - 1) % 5) + 1, math.floor((index - 1) / 5) + 1
    end
    return nil, nil
end

local workspaceVisualCache = {}
local function scanHiveVisuals()
    local myHive = getMyHiveInstance()
    if not myHive then return end
    local cellsFolder = myHive:FindFirstChild("Cells") or myHive:FindFirstChild("Slots") or myHive
    for _, cell in ipairs(cellsFolder:GetChildren()) do
        local col, row = parseSlotPosition(cell.Name)
        if col and row then
            local key = string.format("%d_%d", col, row)
            local cellColor = nil
            local isCellGifted = false

            if cell:IsA("BasePart") then cellColor = cell.Color
            else
                local p = cell:FindFirstChildWhichIsA("BasePart", true)
                if p then cellColor = p.Color end
            end
            if not cellColor then cellColor = Color3.fromRGB(40, 40, 48) end

            for _, desc in ipairs(cell:GetDescendants()) do
                local lower = desc.Name:lower()
                if lower:find("gift") or lower:find("star") or lower:find("sparkle") then
                    isCellGifted = true
                end
            end
            workspaceVisualCache[key] = { Color = cellColor, IsGifted = isCellGifted }
        end
    end
end

