        DetailInfoText.Text = string.format(
            "• Gifted: %s\n• Level: Lv.%d\n• Bond: %s / %s (%.1f%%)\n• Treats cần up Lv tiếp: %s",
            giftedStr, b.Lvl, formatNumber(b.CurBond), formatNumber(b.MaxBond), progressPct, formatNumber(missingTreats)
        )
    end
end

local function renderGrid()
    GridContainer:ClearAllChildren()
    scanHiveVisuals()

    local bees = getParsedHoneycomb()
    liveParsedBees = bees

    for row = 10, 1, -1 do
        local displayY = 10 - row
        for col = 1, 5 do
            local displayX = col - 1
            local slotIdx = (row - 1) * 5 + col
            local bee = bees[slotIdx]

            local cellBox = Instance.new("TextButton")
            cellBox.Text = ""
            cellBox.Size = UDim2.new(0.188, 0, 0.088, 0)
            cellBox.Position = UDim2.new(0.01 + displayX * 0.198, 0, 0.01 + displayY * 0.098, 0)
            cellBox.BorderSizePixel = 0
            cellBox.Parent = GridContainer
            Instance.new("UICorner", cellBox).CornerRadius = UDim.new(0, 4)

            local stroke = Instance.new("UIStroke", cellBox)
            stroke.Thickness = (selectedCol == col and selectedRow == row) and 2 or 1
            stroke.Color = (selectedCol == col and selectedRow == row) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(50, 50, 60)

            local bondBarBg = Instance.new("Frame")
            bondBarBg.Size = UDim2.new(1, -4, 0, 3)
            bondBarBg.Position = UDim2.new(0, 2, 1, -4)
            bondBarBg.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
            bondBarBg.Parent = cellBox
            Instance.new("UICorner", bondBarBg).CornerRadius = UDim.new(1, 0)

            local bondBarFill = Instance.new("Frame")
            bondBarFill.Size = UDim2.new(0, 0, 1, 0)
            bondBarFill.BackgroundColor3 = Color3.fromRGB(255, 205, 50)
            bondBarFill.Parent = bondBarBg
            Instance.new("UICorner", bondBarFill).CornerRadius = UDim.new(1, 0)

            local typeLabel = Instance.new("TextLabel")
            typeLabel.Size = UDim2.new(1, -12, 0, 16)
            typeLabel.Position = UDim2.new(0, 3, 0, 2)
            typeLabel.Font = Enum.Font.SourceSansBold
            typeLabel.TextSize = 8
            typeLabel.TextXAlignment = Enum.TextXAlignment.Left
            typeLabel.BackgroundTransparency = 1
            typeLabel.Parent = cellBox

            local lvlLabel = Instance.new("TextLabel")
            lvlLabel.Size = UDim2.new(0, 12, 0, 16)
            lvlLabel.Position = UDim2.new(1, -13, 0, 2)
            lvlLabel.Font = Enum.Font.SourceSansBold
            lvlLabel.TextSize = 9
            lvlLabel.TextXAlignment = Enum.TextXAlignment.Right
            lvlLabel.BackgroundTransparency = 1
            lvlLabel.Parent = cellBox

            if bee then
                cellBox.BackgroundColor3 = bee.CellColor:Lerp(Color3.fromRGB(20, 20, 24), 0.5)
                lvlLabel.Text = tostring(bee.Lvl)

                local pct = math.clamp(bee.CurBond / bee.MaxBond, 0, 1)
                bondBarFill.Size = UDim2.new(pct, 0, 1, 0)
                bondBarFill.BackgroundColor3 = (pct >= 0.8) and Color3.fromRGB(100, 255, 120) or Color3.fromRGB(255, 205, 50)

                if bee.IsGifted then
                    if selectedCol ~= col or selectedRow ~= row then stroke.Color = Color3.fromRGB(255, 215, 0) end
                    typeLabel.TextColor3 = Color3.fromRGB(255, 225, 75)
                    typeLabel.Text = "★" .. tostring(bee.Type)
                else
                    typeLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
                    typeLabel.Text = tostring(bee.Type)
                end
            else
                cellBox.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
            end

            cellBox.MouseButton1Click:Connect(function()
                selectedCol = col
                selectedRow = row
                InputX.Text = tostring(col)
                InputY.Text = tostring(row)

                local b = liveParsedBees[slotIdx]
                if b then
                    local missingBond = math.max(0, b.MaxBond - b.CurBond)
                    InputTreat.Text = tostring(math.ceil(missingBond / 10))
                end

                renderGrid()
                updateBeeDetailUI(col, row)
            end)
        end
    end

    if selectedCol and selectedRow then
        updateBeeDetailUI(selectedCol, selectedRow)
    end
end

FeedBtn.MouseButton1Click:Connect(function()
    local col = tonumber(InputX.Text)
    local row = tonumber(InputY.Text)
    local amount = tonumber(InputTreat.Text)

    if not col or col < 1 or col > 5 or not row or row < 1 or row > 10 or not amount or amount <= 0 then
        StatusLabel.Text = "❌ Tọa độ hoặc số Treat không hợp lệ!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    StatusLabel.Text = string.format("⏳ Đang cho [%d:%d] ăn %d Treat...", col, row, amount)
    StatusLabel.TextColor3 = Color3.fromRGB(255, 205, 50)

    task.spawn(function()
        local success, result = sendFeedRequest(col, row, amount)
        if success then
            StatusLabel.Text = string.format("✅ Cho ăn thành công!")
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
            task.wait(0.3)
            renderGrid()
        else
            StatusLabel.Text = string.format("❌ Lỗi: %s", tostring(result))
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        end
    end)
end)

-- ==================== XỬ LÝ AUTO LEVEL (CÓ BÁO CÁO SỐ BEE) ====================
StartAutoLvlBtn.MouseButton1Click:Connect(function()
    if isAutoLevelRunning then
        isAutoLevelRunning = false
        StartAutoLvlBtn.Text = "▶ BẮT ĐẦU CHO ĂN AUTO"
        StartAutoLvlBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
        return
    end

    local targetLvl = tonumber(TargetLvlInput.Text)
    if not targetLvl or targetLvl < 2 or targetLvl > 25 then
        AutoLogText.Text = "❌ Cấp độ mục tiêu không hợp lệ (nhập từ 2 đến 25)!"
        AutoLogText.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    isAutoLevelRunning = true
    StartAutoLvlBtn.Text = "⏹ DỪNG AUTO LEVEL"
    StartAutoLvlBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)

    task.spawn(function()
        AutoLogText.TextColor3 = Color3.fromRGB(100, 255, 120)
        
        local beesLeveledUp = 0
        local totalTreatsSpent = 0

        while isAutoLevelRunning do
            scanHiveVisuals()
            local bees = getParsedHoneycomb()
            local myTreats = getMyTreatCount()
            local fedAny = false

            for slotIdx = 1, 50 do
                if not isAutoLevelRunning then break end
                local bee = bees[slotIdx]

                if bee and bee.Lvl < targetLvl then
                    local treatsNeeded = getTreatsNeededToTarget(bee, targetLvl)
                    if treatsNeeded > 0 then
                        if myTreats <= 0 then
                            AutoLogText.Text = string.format("❌ ĐÃ HẾT TREAT!\n• Đã cho ăn: %d con ong lên Lv.%d\n• Đã dùng: %s Treat.", beesLeveledUp, targetLvl, formatNumber(totalTreatsSpent))
                            AutoLogText.TextColor3 = Color3.fromRGB(255, 80, 80)
                            isAutoLevelRunning = false
                            break
                        end

                        local feedAmount = math.min(treatsNeeded, myTreats)
                        AutoLogText.Text = string.format(
                            "⏳ Đang nâng [Cột %d, Hàng %d] Ong %s (Lv.%d ➔ Lv.%d)\n• Đã nâng thành công: %d con ong\n• Đã dùng: %s Treat\n• Đang cho ăn: %s Treat...",
                            bee.Col, bee.Row, bee.Type, bee.Lvl, targetLvl, beesLeveledUp, formatNumber(totalTreatsSpent), formatNumber(feedAmount)
                        )

                        local initialLvl = bee.Lvl
                        local success = sendFeedRequest(bee.Col, bee.Row, feedAmount)
                        if success then
                            fedAny = true
                            totalTreatsSpent = totalTreatsSpent + feedAmount
                            task.wait(0.5)
                            
                            -- Kiểm tra xem con ong đã thực sự lên cấp chưa
                            local updatedBees = getParsedHoneycomb()
                            local updatedBee = updatedBees[slotIdx]
                            if updatedBee and updatedBee.Lvl > initialLvl then
                                beesLeveledUp = beesLeveledUp + 1
                            end

                            renderGrid()
                            break
                        end
                    end
                end
            end

            if not fedAny and isAutoLevelRunning then
                AutoLogText.Text = string.format("🎉 HOÀN THÀNH AUTO LEVEL!\n• Tổng cộng: %d con ong đã đạt Lv.%d\n• Tổng Treat đã tiêu tốn: %s Treat.", beesLeveledUp, targetLvl, formatNumber(totalTreatsSpent))
                AutoLogText.TextColor3 = Color3.fromRGB(100, 255, 120)
                isAutoLevelRunning = false
                break
            end

            task.wait(0.2)
        end

        if not isAutoLevelRunning and AutoLogText.Text:find("Đang nâng") then
            AutoLogText.Text = string.format("⏹ ĐÃ DỪNG AUTO LEVEL.\n• Số ong đã nâng level: %d con\n• Tổng Treat đã dùng: %s Treat.", beesLeveledUp, formatNumber(totalTreatsSpent))
            AutoLogText.TextColor3 = Color3.fromRGB(255, 205, 50)
        end

        StartAutoLvlBtn.Text = "▶ BẮT ĐẦU CHO ĂN AUTO"
        StartAutoLvlBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
    end)
end)

