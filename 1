local function formatNumber(n)
    if not n then return "0" end
    local formatted = tostring(math.floor(n))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then break end
    end
    return formatted
end

local function getMyTreatCount()
    if not StatCache then return 0 end
    local success, data = pcall(function() return StatCache:Get() end)
    if success and type(data) == "table" and data.Eggs then
        return tonumber(data.Eggs.Treat) or 0
    end
    return 0
end

local function sendFeedRequest(col, row, treatAmount)
    if not ConstructRemote then return false, "Không tìm thấy Remote!" end
    return pcall(function()
        return ConstructRemote:InvokeServer(col, row, "Treat", treatAmount)
    end)
end

local function getMyHiveInstance()
    local hives = Workspace:FindFirstChild("Honeycombs") or Workspace:FindFirstChild("Hives")
    if not hives then return nil end
    for _, hive in ipairs(hives:GetChildren()) do
        local owner = hive:FindFirstChild("Owner")
        if owner and (owner.Value == LocalPlayer or tostring(owner.Value) == LocalPlayer.Name or owner.Value == LocalPlayer.UserId) then
            return hive
        end
    end
    return nil
end

local function parseSlotPosition(slotName)
    local c, r = string.match(slotName, "(%d+)%s*[,_x-]%s*(%d+)")
    if c and r then return tonumber(c), tonumber(r) end
    local index = tonumber(string.match(slotName, "%d+"))
    if index and index >= 1 and index <= 50 then
        return ((index - 1) % 5) + 1, math.floor((index - 1) / 5) + 1
    end
    return nil, nil
end

local workspaceVisualCache = {}
local function scanHiveVisuals()
    local myHive = getMyHiveInstance()
    if not myHive then return end
    local cellsFolder = myHive:FindFirstChild("Cells") or myHive:FindFirstChild("Slots") or myHive
    for _, cell in ipairs(cellsFolder:GetChildren()) do
        local col, row = parseSlotPosition(cell.Name)
        if col and row then
            local key = string.format("%d_%d", col, row)
            local cellColor = nil
            local isCellGifted = false

            if cell:IsA("BasePart") then cellColor = cell.Color
            else
                local p = cell:FindFirstChildWhichIsA("BasePart", true)
                if p then cellColor = p.Color end
            end
            if not cellColor then cellColor = Color3.fromRGB(40, 40, 48) end

            for _, desc in ipairs(cell:GetDescendants()) do
                local lower = desc.Name:lower()
                if lower:find("gift") or lower:find("star") or lower:find("sparkle") then
                    isCellGifted = true
                end
            end
            workspaceVisualCache[key] = { Color = cellColor, IsGifted = isCellGifted }
        end
    end
end

local function getParsedHoneycomb()
    if not StatCache then return {} end
    local s, myData = pcall(function() return StatCache:Get() end)
    if not s or type(myData) ~= "table" then return {} end

    local honeycomb = myData.Honeycomb or {}
    local parsed = {}

    for col = 1, 5 do
        local colData = honeycomb["x" .. col] or honeycomb[col]
        if type(colData) == "table" then
            for row = 1, 10 do
                local bee = colData["y" .. row] or colData[row]
                if type(bee) == "table" and bee.Type then
                    local idx = (row - 1) * 5 + col
                    local totalLifetimeBond = tonumber(bee.Bond) or 0
                    local currentLvl = tonumber(bee.Lvl or bee.Level) or 1
                    local energyVal = tonumber(bee.Energy) or 100
                    local beeType = tostring(bee.Type)

                    local baseBondOfThisLvl = CumulativeBondToReachLvl[currentLvl] or 0
                    local currentLvlBond = math.max(0, totalLifetimeBond - baseBondOfThisLvl)
                    local bondRequiredForNextLvl = StepBondForLvl[currentLvl] or 15000

                    local vKey = string.format("%d_%d", col, row)
                    local visual = workspaceVisualCache[vKey]

                    local isGifted = false
                    if bee.Gifted == true or bee.gifted == true or bee.Gift == true then
                        isGifted = true
                    elseif visual and visual.IsGifted then
                        isGifted = true
                    end

                    parsed[idx] = {
                        Col = col, Row = row, Slot = idx,
                        Type = beeType, Lvl = currentLvl, Energy = energyVal,
                        TotalBond = totalLifetimeBond, CurBond = currentLvlBond, MaxBond = bondRequiredForNextLvl,
                        CellColor = visual and visual.Color or Color3.fromRGB(40, 40, 50),
                        IsGifted = isGifted
                    }
                end
            end
        end
    end
    return parsed
end

local function getTreatsNeededToTarget(bee, targetLvl)
    if bee.Lvl >= targetLvl then return 0 end
    local targetTotalBond = CumulativeBondToReachLvl[targetLvl]
    if not targetTotalBond then return 0 end
    
    local neededBond = targetTotalBond - bee.TotalBond
    if neededBond <= 0 then return 0 end
    
    return math.ceil(neededBond / 10)
end

