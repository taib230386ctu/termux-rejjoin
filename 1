            typeLabel.Font = Enum.Font.SourceSansBold
            typeLabel.TextSize = 8
            typeLabel.TextXAlignment = Enum.TextXAlignment.Left
            typeLabel.BackgroundTransparency = 1
            typeLabel.Parent = cellBox

            local lvlLabel = Instance.new("TextLabel")
            lvlLabel.Size = UDim2.new(0, 12, 0, 16)
            lvlLabel.Position = UDim2.new(1, -13, 0, 2)
            lvlLabel.Font = Enum.Font.SourceSansBold
