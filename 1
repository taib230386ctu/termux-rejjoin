-- ==================== ĐỒNG BỘ VÀ VẼ LƯỚI ====================
local liveParsedBees = {}
local selectedSlotIdx = nil
local calculatedSingleTreatsNeeded = 0

local function getParsedHoneycomb()
    pcall(function()
        if ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("RequestHive") then
            ReplicatedStorage.Events.RequestHive:FireServer()
        end
    end)

    local s, myData = pcall(function() return StatCache:Get() end)
    if not s or type(myData) ~= "table" then return {}, 0 end

    local treatsCount = (myData.Eggs and tonumber(myData.Eggs.Treat)) or 0
    local honeycomb = myData.Honeycomb or {}
    local parsed = {}

    for col = 1, 5 do
        local colData = honeycomb["x" .. col] or honeycomb[col]
        if type(colData) == "table" then
            for row = 1, 10 do
                local bee = colData["y" .. row] or colData[row]
                if type(bee) == "table" and bee.Type then
                    local idx = (row - 1) * 5 + col
                    local totalLifetimeBond = tonumber(bee.Bond) or 0
                    local currentLvl = tonumber(bee.Lvl or bee.Level) or 1
                    local energyVal = tonumber(bee.Energy) or 100
                    local beeType = tostring(bee.Type)

                    local baseBondOfThisLvl = CumulativeBondToReachLvl[currentLvl] or 0
                    local currentLvlBond = math.max(0, totalLifetimeBond - baseBondOfThisLvl)
                    local bondRequiredForNextLvl = StepBondForLvl[currentLvl] or 15000

                    local vKey = string.format("%d_%d", col, row)
                    local visual = workspaceVisualCache[vKey]

                    local isGifted = false
                    if bee.Gifted == true or bee.gifted == true or bee.Gift == true then
                        isGifted = true
                    elseif visual and visual.IsGifted then
                        isGifted = true
                    end

                    parsed[idx] = {
                        Col = col, Row = row, Slot = idx,
                        Type = beeType, Lvl = currentLvl, Energy = energyVal,
                        TotalBond = totalLifetimeBond, CurBond = currentLvlBond, MaxBond = bondRequiredForNextLvl,
                        RawCellName = string.format("C%d,%d", col, row),
                        FaceIcon = visual and visual.Image,
                        CellColor = visual and visual.Color or Color3.fromRGB(35, 38, 48),
                        IsGifted = isGifted
                    }
                end
            end
        end
    end
    return parsed, treatsCount
end

local function updateTotalHiveCostDisplay(beesList)
    local bees = beesList or liveParsedBees
    if not bees or next(bees) == nil then return end

    local targetLvl = tonumber(TargetInput.Text) or 8
    local targetCumulativeBond = CumulativeBondToReachLvl[targetLvl] or 0
    local totalBondNeededForHive = 0
    local totalTreatsNeededForHive = 0

    for _, b in pairs(bees) do
        if b and b.Lvl and b.Lvl < targetLvl then
            local missingBondForThisBee = 0
            if targetCumulativeBond > 0 and b.TotalBond then
                missingBondForThisBee = math.max(0, targetCumulativeBond - b.TotalBond)
            else
                missingBondForThisBee = math.max(0, b.MaxBond - b.CurBond)
            end

            local treatsForBee = math.ceil(missingBondForThisBee / 10)
            totalBondNeededForHive = totalBondNeededForHive + missingBondForThisBee
            totalTreatsNeededForHive = totalTreatsNeededForHive + treatsForBee
        end
    end

    local approxHoney = totalTreatsNeededForHive * 10000

    TotalHiveBondLabel.Text = string.format("⚡ Tổng Bond thiếu (Lv.%d): %s", targetLvl, formatNumber(totalBondNeededForHive))
    TotalHiveCostLabel.Text = string.format("🍬 Cần: %s Treats (~%s Honey)", formatNumber(totalTreatsNeededForHive), formatShortNumber(approxHoney))
end

TargetInput.FocusLost:Connect(function() updateTotalHiveCostDisplay() end)

