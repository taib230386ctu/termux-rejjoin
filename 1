        StatusLabel.Text = "⚠️ Hãy chọn 1 con ong trước!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 50)
        return
    end

    if calculatedTreatsNeeded <= 0 then
        StatusLabel.Text = "⚠️ Số lượng Treat phải lớn hơn 0!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 50)
        return
    end

    if not FeedRemote then
        StatusLabel.Text = "❌ Lỗi: Không tìm thấy Remote cho ăn!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    local col = selectedBee.Col
    local row = selectedBee.Row

    StatusLabel.Text = string.format("⏳ Đang cho [%d:%02d] ăn %s Treat...", col, row, formatNumber(calculatedTreatsNeeded))
    StatusLabel.TextColor3 = Color3.fromRGB(255, 205, 50)

    task.spawn(function()
        local success, result = pcall(function()
            return FeedRemote:InvokeServer(col, row, "Treat", calculatedTreatsNeeded)
        end)

        if success then
            StatusLabel.Text = string.format("✅ Đã cho [%d:%02d] ăn thành công!", col, row)
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 120)

            task.wait(0.3)
            renderGrid()
            local updatedBee = liveParsedBees[selectedBee.Slot]
            if updatedBee then
                updateSelectedBeeInfo(updatedBee)
            end
        else
            StatusLabel.Text = "❌ Lỗi khi gửi request: " .. tostring(result)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        end
    end)
end)

