local cachedHiveCFrame = nil

local function tweenTo(targetCFrame, speed)
    speed = speed or 65
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local duration = math.clamp(distance / speed, 0.5, 15)

    local bodyV = Instance.new("BodyVelocity")
    bodyV.Velocity = Vector3.zero
    bodyV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyV.Parent = hrp

    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
    tween:Play()
    tween.Completed:Wait()

    bodyV:Destroy()
end

local function sendFeed(col, row, cellName, amount)
    pcall(function()
        ReplicatedStorage.Events.ConstructHiveCellFromEgg:InvokeServer(col, row, "Treat", amount)
    end)
    pcall(function()
        ReplicatedStorage.Events.PlayerActivesCommand:FireServer({
            ["Name"] = "Feed",
            ["Item"] = "Treat",
            ["Cell"] = cellName,
            ["Amount"] = amount
        })
    end)
end

