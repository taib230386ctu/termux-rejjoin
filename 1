                else
                    DetailBeeTitle.Text = string.format("🐝 Ô %d: (Ô Trống)", slotIdx)
                    DetailInfoText.Text = "Không có thông tin con ong."
                end
            end)
        end
    end
    StatusLabel.Text = "Trạng thái: Đã cập nhật thành công!"
end

RefreshBtn.MouseButton1Click:Connect(renderGrid)
renderGrid()

-- ==================== CHU TRÌNH NÂNG CẤP TỰ ĐỘNG ====================
local isRunning = false
local farmPos = nil

RunAutoBtn.MouseButton1Click:Connect(function()
    if isRunning then return end

    local targetLvl = tonumber(TargetInput.Text)
    if not targetLvl or targetLvl < 2 or targetLvl > 25 then
        StatusLabel.Text = "⚠️ Cấp mục tiêu không hợp lệ!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    local _, treatsNow = getParsedHoneycomb()
    local threshold = (selectedSlotIdx and calculatedSingleTreatsNeeded > 0) and calculatedSingleTreatsNeeded or 1

    if treatsNow < threshold then
        StatusLabel.Text = "❌ Không quay về do thiếu treat!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    if not cachedHiveCFrame then
        local myHive = getMyHiveInstance()
        if myHive then
            local base = myHive:FindFirstChild("Platform") or myHive:FindFirstChildWhichIsA("BasePart")
            if base then cachedHiveCFrame = base.CFrame * CFrame.new(0, 4, 10) end
        end
    end

    if not cachedHiveCFrame then
        StatusLabel.Text = "❌ Chưa lưu vị trí tổ! Đứng trước tổ bấm làm mới 1 lần."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    farmPos = hrp.CFrame

    isRunning = true
    RunAutoBtn.Text = "⚡ Đang chạy..."
    RunAutoBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 20)

    task.spawn(function()
        StatusLabel.Text = "🚀 Đang quay về tổ..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 205, 50)
        tweenTo(cachedHiveCFrame, 65)
        task.wait(0.5)

        local treatDepleted = false
        local slotsToProcess = {}
        if selectedSlotIdx then
            table.insert(slotsToProcess, selectedSlotIdx)
        end
        for i = 1, 50 do
            if i ~= selectedSlotIdx then table.insert(slotsToProcess, i) end
        end

        for _, slotIdx in ipairs(slotsToProcess) do
            if not isRunning or treatDepleted then break end

            local bee = liveParsedBees[slotIdx]
            if bee and bee.Lvl and bee.Lvl < targetLvl then
                while isRunning do
                    local _, curTreats = getParsedHoneycomb()
                    if curTreats <= 0 then
                        treatDepleted = true
                        break
                    end

                    local bFresh = liveParsedBees[slotIdx]
                    if not bFresh or bFresh.Lvl >= targetLvl then break end

                    local targetCumulativeBond = CumulativeBondToReachLvl[targetLvl] or 0
                    local totalBondNeeded = math.max(0, targetCumulativeBond - bFresh.TotalBond)
                    if totalBondNeeded <= 0 then break end

                    local exactTreatsNeeded = math.ceil(totalBondNeeded / 10)
                    local feedAmount = math.min(curTreats, exactTreatsNeeded)

                    StatusLabel.Text = string.format("🐝 Nạp C%d,%d (%s): Nạp %s Treats...", 
                        bFresh.Col, bFresh.Row, tostring(bFresh.Type), formatNumber(feedAmount))
                    StatusLabel.TextColor3 = Color3.fromRGB(120, 255, 140)

                    sendFeed(bFresh.Col, bFresh.Row, bFresh.RawCellName, feedAmount)
                    task.wait(0.6)

                    local freshBees = getParsedHoneycomb()
                    liveParsedBees = freshBees
                    local checkBee = freshBees[slotIdx]
                    if not checkBee or checkBee.Lvl >= targetLvl then break end
                    if feedAmount >= curTreats then
                        treatDepleted = true
                        break
                    end
                end
            end
        end

        if farmPos then
            StatusLabel.Text = "🌾 Trở lại farm..."
            StatusLabel.TextColor3 = Color3.fromRGB(100, 220, 255)
            tweenTo(farmPos, 65)
        end

        if treatDepleted then
            StatusLabel.Text = "🛑 Trở lại farm (Hết treat)."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 180, 80)
        else
            StatusLabel.Text = "🌾 Trở lại farm."
            StatusLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
        end

        isRunning = false
        RunAutoBtn.Text = "🚀 Bay Về Tổ & Nạp"
        RunAutoBtn.BackgroundColor3 = Color3.fromRGB(40, 170, 70)
    end)
end)

StopAutoBtn.MouseButton1Click:Connect(function()
    if not isRunning then return end
    isRunning = false
    StatusLabel.Text = "🌾 Trở lại farm..."
    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    task.spawn(function()
        if farmPos then tweenTo(farmPos, 65) end
        StatusLabel.Text = "🌾 Đã trở lại farm."
        RunAutoBtn.Text = "🚀 Bay Về Tổ & Nạp"
        RunAutoBtn.BackgroundColor3 = Color3.fromRGB(40, 170, 70)
    end)
end)
