-- Hàm tính toán số lượng Treat dựa trên Level mục tiêu
local function calculateTreatsForTargetLvl()
    if not selectedBee then
        CalcInfoLabel.Text = "Treat cần: 0\nHoney tương ứng: 0"
        calculatedTreatsNeeded = 0
        return
    end

    local targetLvl = tonumber(TargetLvlInput.Text) or (selectedBee.Lvl + 1)
    targetLvl = math.clamp(targetLvl, 1, 25)

    if targetLvl <= selectedBee.Lvl then
        CalcInfoLabel.Text = string.format("⚠️ Con ong đã đạt hoặc vượt Lv.%d!", targetLvl)
        CalcInfoLabel.TextColor3 = Color3.fromRGB(255, 150, 100)
        calculatedTreatsNeeded = 0
        FeedBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        return
    end

    local targetTotalBond = CumulativeBondToReachLvl[targetLvl] or 0
    local neededBond = math.max(0, targetTotalBond - selectedBee.TotalBond)

    -- 1 Treat = 10 Bond, 1 Treat = 10 Honey
    calculatedTreatsNeeded = math.ceil(neededBond / 10)
    local neededHoney = calculatedTreatsNeeded * 10

    CalcInfoLabel.Text = string.format("Treat cần lên Lv.%d: %s\nHoney tương ứng: %s", targetLvl, formatNumber(calculatedTreatsNeeded), formatNumber(neededHoney))
    CalcInfoLabel.TextColor3 = Color3.fromRGB(255, 225, 100)

    FeedBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 70)
    FeedBtn.Text = string.format("🍬 Cho Ăn Đến Lv.%d", targetLvl)
end

local function updateSelectedBeeInfo(b)
    selectedBee = b
    if b then
        local rowStr = string.format("%02d", b.Row)
        local progressPct = math.clamp((b.CurBond / b.MaxBond) * 100, 0, 100)
        local giftedStr = b.IsGifted and "Có (★ Gifted)" or "Không"

        DetailBeeTitle.Text = string.format("🐝 Tọa độ [%d:%s] | %s", b.Col, rowStr, tostring(b.Type))
        DetailInfoText.Text = string.format(
            "• Gifted: %s\n• Cấp hiện tại: Lv.%d\n• Bond: %s / %s (%.1f%%)",
            giftedStr, b.Lvl, formatNumber(b.CurBond), formatNumber(b.MaxBond), progressPct
        )

        -- Mặc định để level mục tiêu là level hiện tại + 1
        if tonumber(TargetLvlInput.Text) == nil or tonumber(TargetLvlInput.Text) <= b.Lvl then
            TargetLvlInput.Text = tostring(math.min(25, b.Lvl + 1))
        end

        calculateTreatsForTargetLvl()
        StatusLabel.Text = "Trạng thái: Đã chọn con ong [" .. b.Col .. ":" .. rowStr .. "]"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 220, 120)
    else
        DetailBeeTitle.Text = "🐝 Chọn 1 con ong"
        DetailInfoText.Text = "Ô này hiện chưa có ong."
        calculateTreatsForTargetLvl()
        FeedBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        FeedBtn.Text = "🍬 Cho Ăn Đến Level"
        StatusLabel.Text = "Trạng thái: Chưa chọn con ong hợp lệ"
        StatusLabel.TextColor3 = Color3.fromRGB(200, 100, 100)
    end
end

